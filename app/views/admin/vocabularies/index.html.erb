<div class="admin-container">
  <div class="admin-header">
    <div>
      <p class="admin-kicker">Admin</p>
      <h1>單字管理後台</h1>
      <p class="admin-description">管理 IT 英文詞彙題庫。第一版先建立權限入口，下一步會加入搜尋、篩選、新增與編輯流程。</p>
    </div>
  </div>

  <div class="admin-stats">
    <div class="stat-card">
      <div class="stat-number"><%= @total_count %></div>
      <div class="stat-label">全部單字</div>
    </div>

    <div class="stat-card stat-correct">
      <div class="stat-number"><%= @active_count %></div>
      <div class="stat-label">啟用中</div>
    </div>

    <div class="stat-card stat-wrong">
      <div class="stat-number"><%= @inactive_count %></div>
      <div class="stat-label">已停用</div>
    </div>
  </div>

  <section class="admin-panel">
    <h2>下一步功能</h2>
    <div class="admin-next-steps">
      <div class="admin-step">
        <strong>單字列表</strong>
        <span>顯示英文、中文、分類、難度與狀態。</span>
      </div>
      <div class="admin-step">
        <strong>搜尋與篩選</strong>
        <span>支援英文、中文、分類、難度與啟用狀態。</span>
      </div>
      <div class="admin-step">
        <strong>新增與編輯</strong>
        <span>讓 admin 從後台維護題庫，不必直接改資料庫。</span>
      </div>
    </div>
  </section>
</div>
